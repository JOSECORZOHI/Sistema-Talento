# Base de datos remota (MongoDB Atlas u otro servidor MongoDB)
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=talento_humano

# Puerto HTTP y URL pública del sistema.
# En Railway: APP_BASE_URL=https://tu-proyecto.up.railway.app
PORT=3000
APP_BASE_URL=

# Secreto de firma de JWT (OBLIGATORIO). Genere uno fuerte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Dominio de correo permitido (opcional). Si se define, solo acepta correos de ese dominio.
# ALLOWED_EMAIL_DOMAIN=ejemplo.com

# Orígenes permitidos para CORS (coma separada). Vacío = sin CORS (mismo origen).
ALLOWED_ORIGINS=

# Confianza de proxy para req.ip. Por defecto 'loopback' (solo cabeceras
# X-Forwarded-For desde localhost). Si se despliega detrás de un proxy real,
# definir TRUST_PROXY=1 (o el número de saltos).
TRUST_PROXY=loopback

# No guarde credenciales reales en el repositorio.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth2callback
# En Railway: https://tu-proyecto.up.railway.app/api/gmail/oauth2callback
GMAIL_REFRESH_TOKEN=

# Correo saliente (nodemailer/SMTP). Si SMTP_HOST está vacío, los enlaces de
# recuperación/activación solo se entregan por pantalla en NODE_ENV=development.
# En producción es OBLIGATORIO configurar SMTP (y APP_BASE_URL) para que lleguen correos.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alertas de seguridad al administrador: correo destino por defecto. Si se deja
# vacío, se usa el primer usuario administrador activo de la BD.
ADMIN_ALERT_EMAIL=

# Precarga del modelo OCR (Tesseract 'spa') al arrancar. Defina '0' para desactivarla.
OCR_WARMUP=1

# --- SEGURIDAD / CUMPLIMIENTO (Ley 1581/2012) ---

# Retención documental: días que se conservan los documentos archivados antes de
# purgarlos automáticamente (política de retención, Ley 594/2000). Por defecto 3650
# aunque no se defina. El proceso de retención se ejecuta al arrancar y diariamente.
# DOC_RETENTION_DAYS=3650

# Verificación del certificado TLS del servidor de correo (SMTP).
# Por defecto se VERIFICA el certificado. Defina 'false' SOLO en entornos de prueba
# con certificados autofirmados (no lo haga en producción).
SMTP_REJECT_UNAUTHORIZED=true

# Exponer la contraseña temporal en la respuesta de la API al crear un funcionario
# cuando el correo falla. Defina 'true' SOLO en entornos de prueba SIN SMTP.
# Por defecto NO se expone (recomendado en producción).
ALLOW_TEMP_PASSWORD_RESPONSE=false

# Clave de cifrado EN REPOSO de documentos con datos sensibles (salud y seguridad
# social, Ley 1581/2012). Los documentos sensibles se cifran con AES-256-GCM antes
# de guardarse en GridFS y se descifran transparentemente al leerse.
# DEBE ser una cadena base64 de EXACTAMENTE 32 bytes. Genérela una sola vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# OBLIGATORIA en producción (NODE_ENV=production): si no está definida o no tiene
# 32 bytes válidos, el servidor NO ARRANCA (fail-fast) para no cifrar con una clave
# fallback insegura. Fuera de producción se permite un fallback derivado de
# JWT_SECRET (menos robusto). Se recomienda ROTARLA periódicamente (ver sección de
# gestión de secretos más abajo).
# OJO: si rota DOC_ENC_KEY, debe poder descifrar los documentos existentes; rote
# durante una ventana de mantenimiento y descifre/recifre antes del cambio.
DOC_ENC_KEY=

# --- GESTIÓN DE SECRETOS / ROTACIÓN DE CREDENCIALES ---
# IMPORTANTE (auditoría de cumplimiento):
#  1. NUNCA commitee valores reales en .env ni en el repositorio.
#  2. En Railway use el panel de Variables (menú "Variables") en lugar de .env.
#  3. Rote periódicamente: JWT_SECRET, SMTP_PASS, GMAIL_CLIENT_SECRET, DOC_ENC_KEY.
#  4. Regenere el GMAIL_REFRESH_TOKEN revocándolo en la consola de Google Cloud
#     (APIs y servicios -> Credenciales -> OAuth) y reautorizando con /api/gmail/authorize.
#  5. Acote los permisos de lectura del archivo .env al usuario del servicio.
# Comandos útiles para generar secretos fuertes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
